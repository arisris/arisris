---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const authorEntry = await getEntry("author", "author");
const email = "me@arisris.com"; // Default contact email
---

<Layout title="Contact — Arisris" description="Get in touch with Aris Riswanto for collaborations, freelance, or just to say hi.">
  <div class="max-w-4xl mx-auto py-12 md:py-24 space-y-16">
    {/* Header */}
    <header class="space-y-4 text-center md:text-left">
      <h1 class="text-4xl md:text-6xl font-bold font-outfit tracking-tight">Get in <span class="text-blue-600">touch.</span></h1>
      <p class="text-lg text-neutral-500 dark:text-neutral-400 max-w-2xl">
        Have a project in mind, a question, or just want to say hi? I'd love to hear from you. 
        I usually respond within 24-48 hours.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      {/* Contact Info */}
      <aside class="md:col-span-4 space-y-10">
        <div class="space-y-6">
          <div>
            <h3 class="text-xs font-black uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-4">Email Me</h3>
            <a href={`mailto:${email}`} class="text-lg font-bold hover:text-blue-600 transition-colors border-b-2 border-blue-100 dark:border-blue-900/30 pb-1">
              {email}
            </a>
          </div>

          <div>
            <h3 class="text-xs font-black uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-4">Social Presence</h3>
            <div class="flex flex-col gap-4">
              {authorEntry?.data.social?.github && (
                <a href={authorEntry.data.social.github} class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400 hover:text-blue-600 transition-colors group">
                  <span class="iconify ri--github-fill size-5"></span>
                  <span class="font-medium group-hover:underline">GitHub</span>
                </a>
              )}
              {authorEntry?.data.social?.twitter && (
                <a href={authorEntry.data.social.twitter} class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400 hover:text-blue-600 transition-colors group">
                  <span class="iconify ri--twitter-x-fill size-5"></span>
                  <span class="font-medium group-hover:underline">X / Twitter</span>
                </a>
              )}
              {authorEntry?.data.social?.linkedin && (
                <a href={authorEntry.data.social.linkedin} class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400 hover:text-blue-600 transition-colors group">
                  <span class="iconify ri--linkedin-box-fill size-5"></span>
                  <span class="font-medium group-hover:underline">LinkedIn</span>
                </a>
              )}
            </div>
          </div>

          <div class="p-6 bg-blue-50 dark:bg-blue-900/10 rounded-2xl border border-blue-100 dark:border-blue-900/20">
            <h4 class="text-sm font-bold text-blue-700 dark:text-blue-400 mb-2">Freelance Availability</h4>
            <p class="text-xs text-blue-600/80 dark:text-blue-400/60 leading-relaxed">
              I am currently open to new projects. My focus is on Jamstack strategy, performance optimization, and custom web apps.
            </p>
          </div>
        </div>
      </aside>

      {/* Contact Form */}
      <main class="md:col-span-8">
        <form class="space-y-6" action="#" method="POST">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="text-sm font-bold text-neutral-700 dark:text-neutral-300">Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="John Doe" 
                required
                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all"
              />
            </div>
            <div class="space-y-2">
              <label for="email" class="text-sm font-bold text-neutral-700 dark:text-neutral-300">Email Address</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="john@example.com" 
                required
                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="subject" class="text-sm font-bold text-neutral-700 dark:text-neutral-300">Subject</label>
            <input 
              type="text" 
              id="subject" 
              name="subject" 
              placeholder="Project Inquiry" 
              required
              class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all"
            />
          </div>

          <div class="space-y-2">
            <label for="message" class="text-sm font-bold text-neutral-700 dark:text-neutral-300">Message</label>
            <textarea 
              id="message" 
              name="message" 
              rows="6" 
              placeholder="How can I help you?" 
              required
              class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full md:w-auto px-10 py-4 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl transition-all shadow-lg hover:shadow-blue-600/20 active:scale-[0.98] flex items-center justify-center gap-2"
          >
            Send Message
            <span class="iconify ri--send-plane-fill size-5"></span>
          </button>
        </form>
      </main>
    </div>
  </div>
</Layout>
