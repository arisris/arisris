---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.status === "published");
  const uniqueTags = [...new Set(posts.flatMap((post) => post.data.tags || []))];

  return uniqueTags.map((tag) => {
    const filteredPosts = posts.filter((post) => post.data.tags?.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

// Sort by date descending
const sortedPosts = posts.sort(
  (a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf()
);
---

<Layout title={`Topics: #${tag} — Arisris`} description={`All articles tagged with #${tag}`}>
  <div class="max-w-3xl mx-auto py-12 md:py-20 space-y-12">
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-xs font-black uppercase tracking-widest text-neutral-400">
        <a href="/tags" class="hover:underline">Topics</a>
        <span>/</span>
        <span class="text-blue-600">#{tag}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight font-outfit">
        Articles tagged with <span class="text-blue-600">#{tag}</span>
      </h1>
      <p class="text-lg text-neutral-500 dark:text-neutral-400">
        Showing {posts.length} {posts.length === 1 ? 'result' : 'results'} for this topic.
      </p>
    </header>

    <div class="space-y-10">
      {sortedPosts.map((post) => (
        <article class="group relative flex flex-col md:flex-row gap-6 md:items-center">
          <div class="md:w-1/3 aspect-video overflow-hidden rounded-2xl border border-neutral-100 dark:border-neutral-800">
            <img 
              src={post.data.image} 
              alt={post.data.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="md:w-2/3 space-y-2">
            <time class="text-xs font-bold text-neutral-400 uppercase tracking-widest">
              {post.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <h2 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-neutral-50 group-hover:text-blue-600 transition-colors leading-tight">
              <a href={`/posts/${post.id}`}>
                <span class="absolute inset-0"></span>
                {post.data.title}
              </a>
            </h2>
            <p class="text-neutral-600 dark:text-neutral-400 line-clamp-2 text-sm">
              {post.data.description}
            </p>
          </div>
        </article>
      ))}
    </div>

    <footer class="pt-12 text-center">
      <a href="/tags" class="text-sm font-bold text-neutral-500 hover:text-blue-600 transition-colors">
        ← View all topics
      </a>
    </footer>
  </div>
</Layout>
