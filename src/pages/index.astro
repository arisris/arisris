    pkg: "quran-app-five.vercel.app",
    desc: "Read Quran online — clean PWA, offline-ready, standalone reading experience.",
    link: "https://quran-app-five.vercel.app/",
    icon: "/static/apps/quran.png",
    badge: "web",
    tags: ["pwa", "quran", "reading"],
  },
  {
    name: "AppLirik",
    pkg: "applirik.vercel.app",
    desc: "42k+ song lyrics — Indonesian, dangdut, pop, K-pop & western. Search by title or artist.",
    link: "https://applirik.vercel.app/",
    icon: "ri--mic-line",
    badge: "web",
    tags: ["web", "lyrics", "nextjs"],
