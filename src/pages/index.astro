    tags: ["android", "tools", "4G"],
  },
  {
    name: "VolApp",
    pkg: "com.arisris.android.volapp",
    desc: "Volume button broken? Fix with on-screen slider — ringer/vibrate/silent in one tap, no ads.",
    link: "https://play.google.com/store/apps/details?id=com.arisris.android.volapp&hl=en",
    icon: "/static/apps/volapp.jpg",
    badge: "1K+",
    tags: ["android", "audio", "utility"],
  },
  {
    name: "AIO Tools",
    pkg: "com.arisris.toolsapp",
    desc: "Calculator, AI Image Creator, Notepad & more in 1 — stop switching apps, all tools bundle.",
    link: "https://play.google.com/store/apps/details?id=com.arisris.toolsapp&hl=en",
    icon: "/static/apps/aiotools.png",
    badge: "new",
    tags: ["android", "tools", "ai"],
  },
  {
    name: "Lofi Video Music",
    pkg: "lofi-video-music.arisris.com",
    desc: "Generate lofi music videos — ambient visuals + chill beats for focus & study, runs on CF Workers.",
    link: "https://lofi-video-music.arisris.com/",
    icon: "/static/apps/lofi.svg",
    badge: "web",
