---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");
  const posts = await getCollection("posts", ({ data }) => data.status === "published");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Fetch author info (assuming ID matches what's in the post's author reference)
// In Astro 5, reference() fields store the ID.
const authorEntry = await getEntry("author", "author");
---

<Layout title={`${post.data.title} — arisris.com`} description={post.data.description}>
  <article class="max-w-[720px] mx-auto py-6 space-y-6">
    {/* Breadcrumb */}
    <div class="font-mono text-xs flex flex-wrap items-center gap-1.5 opacity-60">
      <a href="/" class="hover:underline">~/</a>
      <a href="/posts" class="hover:underline">posts</a>
      <span>/</span>
      <span class="truncate max-w-[180px]">{post.id}</span>
      {post.data.tags?.map(tag => (
        <a href={`/tags/${tag}`} class="ml-1 px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 border text-[11px] hover:opacity-100">#{tag.toLowerCase()}</a>
      ))}
    </div>

    <header class="space-y-4">
      <h1 class="font-mono text-lg md:text-xl font-bold tracking-tight leading-snug">
        {post.data.title}
      </h1>
      <p class="font-mono text-xs leading-relaxed opacity-60 max-w-2xl">{post.data.description}</p>

      <div class="flex items-center gap-3 py-3 border-y border-neutral-200 dark:border-neutral-800 font-mono text-xs">
        <img
          src={authorEntry?.data.avatar || "https://avatars.githubusercontent.com/u/62107426?v=4"}
          alt={authorEntry?.data.name}
          class="size-7 rounded-full border"
        />
        <div class="flex flex-col leading-tight">
          <span class="font-medium">{authorEntry?.data.name}</span>
          <span class="text-[11px] opacity-60">
            {post.data.createdAt.toISOString().slice(0,10)}
            {post.data.updatedAt && ` • upd ${post.data.updatedAt.toISOString().slice(0,10)}`}
            <span class="opacity-40"> • {Math.ceil(post.data.description.length / 500 + 5)} min</span>
          </span>
        </div>
        <a href="/posts" class="ml-auto hidden md:inline-flex items-center gap-1 px-2.5 py-1 rounded border text-[11px] hover:bg-neutral-50 dark:hover:bg-neutral-900">
          <span class="iconify ri--arrow-left-line size-3"></span> back
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-[560px] rounded-md overflow-hidden border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900">
      <img src={post.data.image} alt={post.data.title} class="w-full aspect-[16/9] max-h-[280px] object-cover" loading="eager" />
    </div>

    <main class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden">
      <div class="px-3 py-2 border-b bg-neutral-50 dark:bg-neutral-900 font-mono text-xs flex items-center gap-2">
        <span class="iconify ri--markdown-line size-3.5 opacity-60"></span> {post.id}.md
        <span class="ml-auto opacity-40">prose</span>
      </div>
      <div class="p-4 md:p-5 prose prose-sm prose-neutral dark:prose-invert max-w-none
        prose-headings:font-mono prose-headings:text-sm prose-headings:font-bold prose-headings:tracking-tight
        prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-a:underline-offset-2 hover:prose-a:underline
        prose-code:font-mono prose-code:text-xs prose-code:bg-neutral-100 dark:prose-code:bg-neutral-800 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:border prose-code:font-normal
        prose-pre:bg-neutral-950 dark:prose-pre:bg-black prose-pre:rounded-lg prose-pre:border prose-pre:text-xs
        prose-img:rounded-lg prose-img:border prose-li:text-sm prose-p:text-sm prose-p:leading-relaxed">
        <Content />
      </div>
    </main>

    <footer class="flex items-center justify-between pt-4 border-t border-neutral-200 dark:border-neutral-800 font-mono text-xs">
      <a href="/posts" class="inline-flex items-center gap-1 opacity-60 hover:opacity-100">
        <span class="iconify ri--arrow-left-line size-3.5"></span> back to posts
      </a>
      <div class="flex items-center gap-2">
        <span class="opacity-40 hidden md:inline">share:</span>
        <button class="size-7 rounded border hover:bg-neutral-50 dark:hover:bg-neutral-900 flex items-center justify-center" title="Share on X">
          <span class="iconify ri--twitter-x-line size-3.5"></span>
        </button>
        <button class="size-7 rounded border hover:bg-neutral-50 dark:hover:bg-neutral-900 flex items-center justify-center" title="Copy link">
          <span class="iconify ri--link size-3.5"></span>
        </button>
      </div>
    </footer>
  </article>
</Layout>
