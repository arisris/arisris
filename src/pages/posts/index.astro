---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => {
  return data.status === "published";
});

// Sort by date descending
const sortedPosts = posts.sort(
  (a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf()
);

// Extract all unique tags
const allTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="Posts — arisris.com" description="Writings on web dev, Jamstack, perf.">
  <div class="py-6 space-y-6">
    <header class="flex flex-col gap-2 border-b border-neutral-200 dark:border-neutral-800 pb-5">
      <div class="font-mono text-xs opacity-60"><a href="/" class="hover:underline">~/</a> posts</div>
      <h1 class="font-mono text-lg font-bold tracking-tight">posts<span class="opacity-40">/</span> <span class="font-normal text-xs opacity-60">{sortedPosts.length} articles</span></h1>
      <p class="font-mono text-xs opacity-60 max-w-xl">thoughts, tutorials & notes on the modern web — compact, no fluff.</p>
    </header>

    <div class="flex flex-wrap gap-1.5 py-3 border-y border-neutral-200 dark:border-neutral-800 font-mono text-xs">
      <span class="opacity-60 self-center mr-1"># tags:</span>
      {allTags.map(tag => (
        <a href={`/tags/${tag}`} class="px-2 py-1 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded text-[11px] hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">#{tag.toLowerCase()}</a>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {sortedPosts.map((post) => (
        <article class="group flex gap-3 p-3 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-md hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
          <a href={`/posts/${post.id}`} class="shrink-0 size-16 md:size-20 rounded overflow-hidden bg-neutral-100 dark:bg-neutral-800 block">
            <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
          </a>
          <div class="min-w-0 flex-1 space-y-1">
            <div class="flex items-center gap-1.5 font-mono text-[10px] opacity-60">
              <time datetime={post.data.createdAt.toISOString()}>{post.data.createdAt.toISOString().slice(0,10)}</time>
              <span class="px-1 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 border text-[10px]">{post.data.tags?.[0]?.toLowerCase() || 'post'}</span>
            </div>
            <h2 class="font-mono text-xs font-bold leading-snug line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              <a href={`/posts/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="text-[11px] leading-relaxed opacity-70 line-clamp-2">{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>

    {sortedPosts.length === 0 && (
      <div class="py-20 text-center">
        <p class="text-neutral-500">No posts found yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>
