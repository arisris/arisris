---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => {
    return data.status === "published";
  });
  return pages.map((page) => ({
    params: { id: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Layout title={`${page.data.title} — Arisris`} description={page.data.description}>
  <article class="max-w-3xl mx-auto py-12 md:py-20 space-y-10">
    <header class="space-y-4 border-b border-neutral-100 dark:border-neutral-800 pb-8">
      <h1 class="text-4xl md:text-5xl font-bold font-outfit tracking-tight text-neutral-900 dark:text-neutral-50">
        {page.data.title}
      </h1>
      <p class="text-sm text-neutral-500">
        Last updated: {page.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </header>

    <main class="prose prose-neutral dark:prose-invert prose-lg max-w-none 
      prose-headings:font-outfit prose-headings:font-bold prose-headings:tracking-tight
      prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline">
      <Content />
    </main>

    <footer class="pt-12 border-t border-neutral-100 dark:border-neutral-800">
      <a href="/" class="text-sm font-bold text-neutral-500 hover:text-blue-600 transition-colors">
        ← Back to home
      </a>
    </footer>
  </article>
</Layout>
