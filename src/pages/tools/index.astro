---
import Layout from "../../layouts/Layout.astro";
import { tools } from "../../data/tools";
---

<Layout title="Online Tools - Aris Riswanto" description="Free online web developer tools and utilities by Aris Riswanto.">
  <div class="max-w-4xl mx-auto py-12 md:py-24 space-y-16">
    <header class="border-b border-neutral-100 dark:border-neutral-800 pb-10">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight font-outfit text-neutral-900 dark:text-neutral-50">
        Online <span class="text-blue-600 dark:text-blue-500">Tools</span>
      </h1>
      <p class="mt-4 text-lg text-neutral-500 dark:text-neutral-400">
        A collection of handy web utilities and developer tools. Fast, secure, and runs entirely in your browser.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {tools.map(tool => (
        <a href={`/tools/${tool.id}`} class="group p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 hover:border-blue-500 dark:hover:border-blue-500 transition-all hover:shadow-sm bg-white dark:bg-neutral-900 flex items-start flex-col h-full">
          <div class="flex items-center gap-4 mb-4">
            <div class="size-10 rounded-lg bg-blue-50 dark:bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform">
              <span class={`iconify ${tool.icon} size-5`}></span>
            </div>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-white font-outfit">{tool.name}</h2>
          </div>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm grow">
            {tool.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</Layout>
