---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a href="/" class:list={["flex items-center gap-2 select-none font-mono", className]}>
  <span class="inline-flex items-center justify-center size-7 rounded bg-neutral-900 dark:bg-white text-white dark:text-black text-xs font-bold">AR</span>
  <span class="hidden md:inline text-sm font-bold tracking-tight">arisris.com</span>
  <span class="md:hidden text-sm font-bold">AR</span>
</a>
