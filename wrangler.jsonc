{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "arisris-website",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "arisris.com",
			"custom_domain": true
		},
		{
			"pattern": "www.arisris.com",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-11-08",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "8ecf0186b24e4b69b9cad77f57d9791b"
		}
	],
	"observability": {
		"enabled": true
	}
}